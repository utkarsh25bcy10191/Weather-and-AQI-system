      }
    }

    const fallbackReply = generateFallbackChatResponse(latestUserMessage, userProfile, weatherData, aqiData, locationName);
    return res.json({ reply: fallbackReply, source: "fallback_engine" });
  } catch {
    const fallbackReply = generateFallbackChatResponse(latestUserMessage, userProfile, weatherData, aqiData, locationName);
    return res.json({ reply: fallbackReply, source: "fallback_engine" });
  }
});

