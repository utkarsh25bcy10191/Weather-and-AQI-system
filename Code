// Vite Middleware for development & Static serving for production
async function startServer() {
  // Resolve dist directory across various execution roots (root, /app, /app/applet, etc.)
  const possibleDist = [
    path.join(process.cwd(), "dist"),
    typeof __dirname !== "undefined" ? __dirname : "",
    path.join(process.cwd(), "applet", "dist"),
  ].find((p) => p && fs.existsSync(path.join(p, "index.html")));

  const isProduction =
    process.env.NODE_ENV === "production" ||
    Boolean(process.env.K_SERVICE && !process.env.VITE_DEV_SERVER) ||
    (Boolean(possibleDist) && process.env.npm_lifecycle_event !== "dev" && process.env.NODE_ENV !== "development");

  if (!isProduction || !possibleDist) {
    try {
      const { createServer: createViteServer } = await import("vite");
      const vite = await createViteServer({
        server: { middlewareMode: true },
        appType: "spa",
      });
      app.use(vite.middlewares);
      console.log("Vite development middleware mounted successfully");
    } catch (err: any) {
      console.error("Vite middleware error (falling back to static if available):", err?.message);
      if (possibleDist) {
        app.use(express.static(possibleDist));
        app.get("*", (_req, res) => {
          res.sendFile(path.join(possibleDist, "index.html"));
        });
      }
    }
  } else {
    console.log(`Serving production static build from: ${possibleDist}`);
    app.use(express.static(possibleDist));
    app.get("*", (_req, res) => {
      res.sendFile(path.join(possibleDist, "index.html"));
    });
  }

  // Primary listen
  app.listen(PRIMARY_PORT, "0.0.0.0", () => {
    console.log(`LumeAir server running on http://0.0.0.0:${PRIMARY_PORT} (NODE_ENV=${process.env.NODE_ENV})`);
  });

  // Secondary listen if deployed to Cloud Run where PORT is set and differs from PRIMARY_PORT and NGINX_PORT is not present
  const altPort = process.env.PORT ? parseInt(process.env.PORT, 10) : null;
  if (
    altPort &&
    altPort !== PRIMARY_PORT &&
    !process.env.NGINX_PORT &&
    !isNaN(altPort)
  ) {
    try {
      app.listen(altPort, "0.0.0.0", () => {
        console.log(`LumeAir server also accepting connections on container PORT http://0.0.0.0:${altPort}`);
      });
    } catch (e: any) {
      console.warn(`Could not bind secondary port ${altPort}:`, e?.message);
    }
  }
}

