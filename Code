<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" fill="none">
  <rect width="32" height="32" rx="8" fill="#0A0A14"/>
  <rect x="1" y="1" width="30" height="30" rx="7" stroke="url(#cyanGrad)" stroke-width="1.5" stroke-opacity="0.6"/>
  <path d="M7 11h11a3 3 0 1 0-3-3" stroke="url(#cyanGrad)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M5 16h17a3.5 3.5 0 1 1-3.5 3.5" stroke="#38BDF8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
  <path d="M8 21h6a2.5 2.5 0 1 0-2.5-2.5" stroke="#06B6D4" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
  <defs>
    <linearGradient id="cyanGrad" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
      <stop stop-color="#06B6D4"/>
