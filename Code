              <span className="w-2 h-2 rounded-full bg-emerald-400 animate-pulse shadow-[0_0_8px_rgba(52,211,153,0.8)]" />
              <span className="text-slate-300 font-medium">LumeAir Host Online</span>
            </div>
            <span className="hidden md:inline">•</span>
            <span className="hidden md:inline">CPCB NAQI Reference</span>
            <span className="hidden md:inline">•</span>
            <span className="hidden md:inline">US & Global Atmospheric Telemetry</span>
          </div>
        </div>

        {/* Terms & Conditions / Data Variance Notice */}
        <div className="max-w-7xl mx-auto mt-3.5 pt-3 border-t border-slate-800/60 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2.5 text-[11px] text-slate-500">
          <p className="leading-relaxed">
            <span className="font-semibold text-slate-400">Terms & Conditions:</span> Environmental and air quality data displayed on this platform is compiled from US reserves and international atmospheric satellite models, and may vary from official Indian versions, local Central Pollution Control Board (CPCB) monitoring stations, or regional government bulletins. Telemetry is provided strictly for educational and precautionary awareness.
          </p>
          <span className="shrink-0 text-[10px] font-mono px-2.5 py-0.5 rounded-full bg-slate-800/80 text-cyan-400/90 border border-slate-700/60 flex items-center gap-1.5">
            <span className="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
            US Telemetry Baseline
          </span>
        </div>
      </footer>

      {/* MODALS & CHATBOT */}
      <AuthModal
        isOpen={isAuthModalOpen}
        onClose={() => setIsAuthModalOpen(false)}
        onLoginSuccess={handleLoginSuccess}
        existingUsers={usersMap}
      />

      {currentUser && (
        <ProfileModal
          isOpen={isProfileModalOpen}
          onClose={() => setIsProfileModalOpen(false)}
          profile={currentUser}
          onUpdateProfile={handleUpdateProfile}
          onLogout={handleLogout}
        />
      )}

      {currentUser && (
        <AlertHistoryModal
          isOpen={isAlertModalOpen}
          onClose={() => setIsAlertModalOpen(false)}
          alerts={alerts}
          userName={currentUser.fullName}
          onClearAlerts={handleClearAlerts}
          onLogCurrentAlert={handleManualLogAlert}
        />
      )}

      {/* FLOATING ACTION LAUNCHER FOR HEALTH CHATBOT */}
      {!isChatbotOpen && (
        <div className="fixed bottom-5 right-5 z-40">
          <button
            id="floating-health-chat-btn"
            onClick={() => setIsChatbotOpen(true)}
            className="flex items-center gap-3 px-4 py-3 rounded-full bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 font-bold text-xs shadow-[0_0_25px_rgba(6,182,212,0.55)] transition-all hover:scale-105 active:scale-95 cursor-pointer group"
          >
            <div className="w-8 h-8 rounded-full bg-slate-950 text-cyan-400 flex items-center justify-center shadow-inner">
              <HeartPulse className="w-4 h-4 animate-pulse text-cyan-400" />
            </div>
            <div className="text-left leading-tight pr-1">
              <div className="flex items-center gap-1.5">
                <span className="text-slate-950 font-extrabold text-xs">
                  Ask Health AI
                </span>
                <span className="text-[9px] uppercase font-mono px-1 py-0.2 rounded bg-slate-950/20 text-slate-950 font-bold">
                  Live
                </span>
              </div>
              <span className="block text-[10px] text-slate-900 font-semibold opacity-90">
                Weather & AQI Assistant
              </span>
            </div>
          </button>
        </div>
      )}

      {/* HEALTH AI CHATBOT MODAL / DRAWER */}
      <HealthChatbotModal
        isOpen={isChatbotOpen}
        onClose={() => setIsChatbotOpen(false)}
        currentUser={currentUser}
        location={currentLocation}
        weather={weather}
        aqi={aqi}
      />
    </div>
  );
}
