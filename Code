type ViewMode = 'divided' | 'cards' | 'aqi_only' | 'temp_only';

// Helper to get CPCB AQI color and category
const getAqiDetails = (val: number) => {
  if (val <= 50) return { category: 'Good', color: '#10b981', bg: 'bg-emerald-500/15', text: 'text-emerald-400', border: 'border-emerald-500/30' };
  if (val <= 100) return { category: 'Satisfactory', color: '#22c55e', bg: 'bg-green-500/15', text: 'text-green-400', border: 'border-green-500/30' };
  if (val <= 200) return { category: 'Moderate', color: '#eab308', bg: 'bg-yellow-500/15', text: 'text-yellow-400', border: 'border-yellow-500/30' };
  if (val <= 300) return { category: 'Poor', color: '#f97316', bg: 'bg-orange-500/15', text: 'text-orange-400', border: 'border-orange-500/30' };
  if (val <= 400) return { category: 'Very Poor', color: '#ef4444', bg: 'bg-rose-500/15', text: 'text-rose-400', border: 'border-rose-500/30' };
  return { category: 'Severe', color: '#991b1b', bg: 'bg-red-900/30', text: 'text-red-400', border: 'border-red-500/40' };
};

// Weather icon helper
const getWeatherIcon = (code: number, condition: string) => {
  const cond = (condition || '').toLowerCase();
  if (cond.includes('thunder') || code >= 95) return <CloudLightning className="w-4 h-4 text-purple-400" />;
  if (cond.includes('rain') || cond.includes('drizzle') || (code >= 50 && code <= 67) || (code >= 80 && code <= 82)) {
    return <CloudRain className="w-4 h-4 text-blue-400" />;
  }
  if (cond.includes('fog') || cond.includes('haze') || code === 45 || code === 48) {
    return <CloudFog className="w-4 h-4 text-slate-400" />;
  }
  if (cond.includes('cloud') || cond.includes('overcast') || code === 2 || code === 3) {
    return <Cloud className="w-4 h-4 text-slate-300" />;
  }
  return <Sun className="w-4 h-4 text-amber-400" />;
};

export const WeeklyTrendChart: React.FC<WeeklyTrendChartProps> = ({ trendData, locationName }) => {
  // Default to 'divided' to cleanly separate the graphs, with 'cards' as simplified alternative
  const [viewMode, setViewMode] = useState<ViewMode>('divided');
  const [selectedDayIndex, setSelectedDayIndex] = useState<number>(trendData.length > 0 ? trendData.length - 1 : 0);

  if (!trendData || trendData.length === 0) {
    return (
      <div className="flex flex-col items-center justify-center h-full p-6 bg-[#161622] rounded-3xl border border-slate-800/80 text-slate-400">
        <Calendar className="w-8 h-8 mb-2 text-cyan-400 animate-pulse" />
        <p className="text-sm">Synthesizing 7-day meteorological history...</p>
      </div>
    );
  }

  const activeDay = trendData[selectedDayIndex] || trendData[trendData.length - 1];
  const activeAqiDetails = getAqiDetails(activeDay.aqi);

  // Summary statistics
  const avgAqi = Math.round(trendData.reduce((acc, curr) => acc + curr.aqi, 0) / trendData.length);
  const avgAqiDetails = getAqiDetails(avgAqi);
  const avgTemp = (trendData.reduce((acc, curr) => acc + (curr.tempMax + curr.tempMin) / 2, 0) / trendData.length).toFixed(1);

  // SVG Chart Dimensions for clean single-metric sub-graphs
  const svgW = 540;
  const svgH = 150;
  const padL = 35;
  const padR = 25;
  const padT = 28;
  const padB = 28;
  const plotW = svgW - padL - padR;
  const plotH = svgH - padT - padB;
  const stepX = trendData.length > 1 ? plotW / (trendData.length - 1) : plotW;

  // AQI bounds
  const aqiVals = trendData.map((d) => d.aqi);
  const maxAqiBound = Math.max(160, Math.ceil((Math.max(...aqiVals) + 20) / 50) * 50);
  const minAqiBound = 0;

  // Temp bounds
  const allTemps = trendData.flatMap((d) => [d.tempMax, d.tempMin]);
  const maxTempBound = Math.ceil((Math.max(...allTemps) + 2) / 5) * 5;
  const minTempBound = Math.floor((Math.min(...allTemps) - 2) / 5) * 5;

  // AQI points
  const aqiPoints = trendData.map((d, i) => {
    const x = padL + i * stepX;
    const norm = (d.aqi - minAqiBound) / (maxAqiBound - minAqiBound || 1);
    const y = padT + plotH - norm * plotH;
    return { x, y, val: d.aqi, item: d };
  });

  // Temp points
  const tempMaxPoints = trendData.map((d, i) => {
    const x = padL + i * stepX;
    const norm = (d.tempMax - minTempBound) / (maxTempBound - minTempBound || 1);
    const y = padT + plotH - norm * plotH;
    return { x, y, val: d.tempMax, item: d };
  });

  const tempMinPoints = trendData.map((d, i) => {
    const x = padL + i * stepX;
    const norm = (d.tempMin - minTempBound) / (maxTempBound - minTempBound || 1);
    const y = padT + plotH - norm * plotH;
    return { x, y, val: d.tempMin, item: d };
  });

  // Bezier path generator
  const createSmoothPath = (pts: Array<{ x: number; y: number }>) => {
    if (pts.length === 0) return '';
    let path = `M ${pts[0].x} ${pts[0].y}`;
    for (let i = 0; i < pts.length - 1; i++) {
      const p0 = pts[i === 0 ? 0 : i - 1];
      const p1 = pts[i];
      const p2 = pts[i + 1];
      const p3 = pts[i + 2] || p2;
      const cp1x = p1.x + (p2.x - p0.x) / 6;
      const cp1y = p1.y + (p2.y - p0.y) / 6;
      const cp2x = p2.x - (p3.x - p1.x) / 6;
