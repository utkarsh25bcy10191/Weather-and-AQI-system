              2
            )}&count=1`
          );
          let name = `My GPS Location (${lat.toFixed(2)}°N, ${lon.toFixed(2)}°E)`;
          if (geoRes.ok) {
            const gData = await geoRes.json();
            if (gData.results && gData.results[0]) {
              name = gData.results[0].name;
            }
          }

          setCurrentLocation({
            name,
            lat,
            lon,
            isIndia: lat >= 7.0 && lat <= 38.0 && lon >= 67.0 && lon <= 98.0,
          });
        } catch {
          setCurrentLocation({
            name: `GPS (${lat.toFixed(2)}°N, ${lon.toFixed(2)}°E)`,
            lat,
            lon,
            isIndia: lat >= 7.0 && lat <= 38.0 && lon >= 67.0 && lon <= 98.0,
          });
        } finally {
          setIsDetectingLocation(false);
        }
      },
      (err) => {
        console.warn('Geolocation denied or unavailable:', err.message);
        setIsDetectingLocation(false);
        // Default to New Delhi if GPS denied
        setCurrentLocation(PRESET_INDIAN_CITIES[0]);
      },
      { timeout: 8000 }
    );
  };

