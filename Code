import React, { useState } from 'react';
import { AlertHistoryItem } from '../types';
import { Bell, ShieldAlert, Calendar, MapPin, Trash2, Download, AlertTriangle, CheckCircle2, Filter } from 'lucide-react';

interface AlertHistoryModalProps {
  isOpen: boolean;
  onClose: () => void;
  alerts: AlertHistoryItem[];
  userName: string;
  onClearAlerts: () => void;
  onLogCurrentAlert?: () => void;
}

export const AlertHistoryModal: React.FC<AlertHistoryModalProps> = ({
  isOpen,
  onClose,
  alerts,
  userName,
  onClearAlerts,
  onLogCurrentAlert,
}) => {
  const [filterSeverity, setFilterSeverity] = useState<'all' | 'severe' | 'high' | 'moderate'>('all');

  if (!isOpen) return null;

  const filteredAlerts = alerts.filter((item) => {
    if (filterSeverity === 'all') return true;
    return item.severity === filterSeverity;
  });

  const exportAlerts = () => {
    const dataStr = 'data:text/json;charset=utf-8,' + encodeURIComponent(JSON.stringify(alerts, null, 2));
    const downloadAnchor = document.createElement('a');
    downloadAnchor.setAttribute('href', dataStr);
    downloadAnchor.setAttribute('download', `lumeair_alerts_${userName.toLowerCase()}_${new Date().toISOString().slice(0, 10)}.json`);
    document.body.appendChild(downloadAnchor);
    downloadAnchor.click();
    downloadAnchor.remove();
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md animate-fade-in">
      <div
        id="alert-history-modal-card"
        className="relative w-full max-w-2xl bg-[#0F0F17] border border-slate-800/80 rounded-3xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh]"
      >
        {/* Header */}
        <div className="px-6 py-4 bg-[#0A0A10]/90 border-b border-slate-800/60 flex items-center justify-between">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-500 to-red-600 flex items-center justify-center text-white shadow-[0_0_12px_rgba(245,158,11,0.3)]">
              <Bell className="w-5 h-5" />
            </div>
            <div>
              <h3 className="text-base font-bold text-slate-100 flex items-center gap-2">
                Personalized Alert History
                <span className="text-xs font-mono font-bold px-2 py-0.5 rounded-full bg-slate-800 border border-slate-700 text-cyan-400">
                  {alerts.length} Total
                </span>
              </h3>
              <p className="text-xs text-slate-400">
                Persistent log for <strong className="text-slate-300">{userName}</strong> — preserved across logout and login sessions
              </p>
            </div>
          </div>
          <button
            onClick={onClose}
            className="text-slate-400 hover:text-slate-200 p-2 rounded-full hover:bg-slate-800/60 text-sm font-mono cursor-pointer"
          >
            ✕
          </button>
        </div>

        {/* Toolbar & Filter */}
        <div className="px-6 py-3 bg-slate-950/40 border-b border-slate-800/80 flex flex-wrap items-center justify-between gap-2.5">
          <div className="flex items-center gap-1.5 text-xs">
            <Filter className="w-3.5 h-3.5 text-slate-400 mr-1" />
            {(['all', 'severe', 'high', 'moderate'] as const).map((sev) => (
              <button
                key={sev}
                onClick={() => setFilterSeverity(sev)}
                className={`px-2.5 py-1 rounded-lg font-medium capitalize transition-all ${
                  filterSeverity === sev
                    ? 'bg-slate-800 text-cyan-300 border border-cyan-500/40'
                    : 'text-slate-400 hover:text-slate-200'
                }`}
              >
                {sev}
              </button>
            ))}
          </div>

          <div className="flex items-center gap-2">
            {onLogCurrentAlert && (
              <button
                onClick={onLogCurrentAlert}
                className="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-cyan-950/80 hover:bg-cyan-900 border border-cyan-500/40 text-cyan-300 text-xs font-medium transition-colors"
                title="Log current location's live AQI and advisory to alert history"
              >
                <ShieldAlert className="w-3.5 h-3.5 text-cyan-400" />
                <span>Log Current Advisory</span>
              </button>
            )}
            {alerts.length > 0 && (
              <>
                <button
                  onClick={exportAlerts}
                  className="flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs transition-colors"
                  title="Export JSON log"
                >
                  <Download className="w-3.5 h-3.5" />
                  <span>Export</span>
                </button>
                <button
                  onClick={onClearAlerts}
                  className="flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl bg-rose-950/40 hover:bg-rose-950 text-rose-300 border border-rose-800/50 text-xs transition-colors"
                  title="Clear history"
                >
                  <Trash2 className="w-3.5 h-3.5" />
                  <span>Clear</span>
                </button>
              </>
            )}
          </div>
        </div>

        {/* Alerts List */}
        <div className="p-6 overflow-y-auto space-y-3 flex-1">
          {filteredAlerts.length === 0 ? (
            <div className="flex flex-col items-center justify-center py-12 text-center text-slate-400">
              <CheckCircle2 className="w-12 h-12 mb-3 text-emerald-500/60" />
              <h4 className="text-sm font-semibold text-slate-200">No Recorded Alerts</h4>
              <p className="text-xs text-slate-500 max-w-sm mt-1">
                {filterSeverity === 'all'
                  ? 'No environmental advisories have been triggered or logged yet for this profile.'
                  : `No ${filterSeverity} severity alerts found.`}
              </p>
            </div>
          ) : (
            filteredAlerts.map((alert) => {
              const dateObj = new Date(alert.timestamp);
              const formattedDate = dateObj.toLocaleDateString('en-US', {
                month: 'short',
                day: 'numeric',
                year: 'numeric',
              });
              const formattedTime = dateObj.toLocaleTimeString('en-US', {
                hour: '2-digit',
                minute: '2-digit',
              });

              return (
                <div
                  key={alert.id}
                  className={`p-4 rounded-xl border backdrop-blur-xs transition-all ${
                    alert.severity === 'severe'
                      ? 'bg-rose-950/20 border-rose-500/40'
                      : alert.severity === 'high'
                      ? 'bg-orange-950/20 border-orange-500/40'
                      : alert.severity === 'moderate'
                      ? 'bg-amber-950/20 border-amber-500/40'
                      : 'bg-slate-950/60 border-slate-800'
                  }`}
                >
                  <div className="flex flex-wrap items-start justify-between gap-2 mb-2">
                    <div className="flex items-center gap-2">
                      <span
                        className={`w-2.5 h-2.5 rounded-full ${
                          alert.severity === 'severe'
                            ? 'bg-rose-500 animate-pulse'
                            : alert.severity === 'high'
                            ? 'bg-orange-500'
                            : 'bg-amber-500'
                        }`}
                      />
                      <h4 className="text-sm font-bold text-slate-100">{alert.title}</h4>
                      <span
                        className={`text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full ${
                          alert.severity === 'severe'
                            ? 'bg-rose-500/20 text-rose-300 border border-rose-500/40'
                            : alert.severity === 'high'
                            ? 'bg-orange-500/20 text-orange-300 border border-orange-500/40'
                            : 'bg-amber-500/20 text-amber-300 border border-amber-500/40'
                        }`}
                      >
                        {alert.severity}
                      </span>
                    </div>

                    <div className="text-[11px] text-slate-400 flex items-center gap-1.5 font-mono">
                      <Calendar className="w-3.5 h-3.5 text-slate-500" />
                      <span>
                        {formattedDate} at {formattedTime}
                      </span>
                    </div>
                  </div>

                  {/* Location & Metrics Strip */}
                  <div className="flex flex-wrap items-center gap-3 text-xs mb-2.5 text-slate-300">
                    <div className="flex items-center gap-1">
                      <MapPin className="w-3.5 h-3.5 text-cyan-400" />
                      <span className="font-semibold text-slate-200">{alert.locationName}</span>
                    </div>
                    <div className="flex items-center gap-1">
                      <span className="text-slate-400">AQI:</span>
                      <span className="font-bold text-amber-400">{alert.aqi}</span>
                      <span className="text-[10px] text-slate-400">({alert.category})</span>
                    </div>
                    <div className="flex items-center gap-1">
                      <span className="text-slate-400">Temp:</span>
                      <span className="font-semibold text-sky-400">{alert.temp}°C</span>
                    </div>
                  </div>

                  {/* Summary / Guidance */}
                  <p className="text-xs text-slate-300 leading-relaxed bg-slate-950/40 p-2.5 rounded-lg border border-slate-800/80">
                    {alert.summary}
                  </p>

                  {/* Trigger Factors Tags */}
                  {alert.triggerFactors && alert.triggerFactors.length > 0 && (
                    <div className="flex flex-wrap items-center gap-1.5 mt-2">
                      {alert.triggerFactors.map((factor, fIdx) => (
                        <span
                          key={fIdx}
                          className="text-[10px] px-2 py-0.5 rounded-md bg-slate-800/80 border border-slate-700/80 text-slate-300"
                        >
                          {factor}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              );
            })
          )}
        </div>

        {/* Footer */}
        <div className="px-6 py-3 bg-slate-950/80 border-t border-slate-800 flex items-center justify-between text-xs text-slate-400">
          <span className="flex items-center gap-1.5">
            <ShieldAlert className="w-4 h-4 text-cyan-400" />
            Automatic threshold detection for Asthma & High PM2.5 Active
          </span>
          <button
            onClick={onClose}
            className="px-4 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-medium transition-colors"
          >
            Close
          </button>
        </div>
      </div>
    </div>
  );
};
import React, { useState } from 'react';
import { UserProfile, AgeGroup } from '../types';
import { ShieldCheck, Key, Github, User, HeartPulse, Briefcase, Sparkles, Check, ArrowRight } from 'lucide-react';

interface AuthModalProps {
  isOpen: boolean;
  onClose: () => void;
  onLoginSuccess: (profile: UserProfile) => void;
  existingUsers: Record<string, UserProfile>;
}

const AGE_GROUPS: AgeGroup[] = [
  'child(0-12)',
  'teen(12-19)',
  'Adult(20-35)',
  'middle age(35-50)',
  'senior(50+)',
];

const PRESET_HEALTH_CONDITIONS = [
  { id: 'asthma', label: 'Asthma (Hyper-reactive airways)', critical: true },
  { id: 'bronchitis', label: 'Bronchitis / COPD', critical: true },
  { id: 'cardiovascular', label: 'Cardiovascular / Heart Disease', critical: true },
  { id: 'dust_allergy', label: 'Dust & Pollen Allergy (Rhinitis)', critical: false },
  { id: 'sinusitis', label: 'Chronic Sinusitis', critical: false },
  { id: 'pregnancy', label: 'Pregnancy', critical: true },
  { id: 'healthy', label: 'None / Generally Healthy', critical: false },
];

const PRESET_OCCUPATIONS = [
  'Outdoor Field Worker / Construction',
  'Delivery Partner / Transit Driver',
  'Athlete / Outdoor Sports',
  'Indoor / Desk / IT Professional',
  'Student / Academic',
  'Senior Citizen / Retired',
  'Healthcare / Emergency Worker',
  'Other',
];

export const AuthModal: React.FC<AuthModalProps> = ({
  isOpen,
  onClose,
  onLoginSuccess,
  existingUsers,
}) => {
  const [step, setStep] = useState<'enter_id' | 'create_profile'>('enter_id');
  const [userIdInput, setUserIdInput] = useState('');
  const [fullName, setFullName] = useState('');
  const [selectedAgeGroup, setSelectedAgeGroup] = useState<AgeGroup>('Adult(20-35)');
  const [selectedConditions, setSelectedConditions] = useState<string[]>(['asthma']);
  const [selectedOccupation, setSelectedOccupation] = useState<string>('Indoor / Desk / IT Professional');
  const [customNotes, setCustomNotes] = useState('');
  const [errorMsg, setErrorMsg] = useState('');

  if (!isOpen) return null;

  const handleIdSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    const cleanId = userIdInput.trim().toLowerCase();
    if (!cleanId) {
      setErrorMsg('Please enter a valid User ID or GitHub handle.');
      return;
    }

    setErrorMsg('');
    // Check if this ID already exists
    if (existingUsers[cleanId]) {
      // Existing user: direct login!
      onLoginSuccess(existingUsers[cleanId]);
      onClose();
    } else {
      // New user: proceed to step 2 to create their profile
      setFullName(cleanId.replace(/[-_.]/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()));
      setStep('create_profile');
    }
  };

  const handleCreateProfileSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    const cleanId = userIdInput.trim().toLowerCase();

    const newProfile: UserProfile = {
      id: cleanId,
      username: cleanId,
      fullName: fullName.trim() || cleanId,
      avatarSeed: cleanId,
      ageGroup: selectedAgeGroup,
      conditions: selectedConditions,
      occupation: selectedOccupation,
      notes: customNotes.trim(),
      createdAt: new Date().toISOString(),
      updatedAt: new Date().toISOString(),
    };

    onLoginSuccess(newProfile);
    onClose();
  };

  const toggleCondition = (condId: string) => {
    if (condId === 'healthy') {
      setSelectedConditions(['healthy']);
      return;
    }
    const filtered = selectedConditions.filter((c) => c !== 'healthy');
    if (filtered.includes(condId)) {
      setSelectedConditions(filtered.filter((c) => c !== condId));
    } else {
      setSelectedConditions([...filtered, condId]);
    }
  };

  // Quick Demo Profiles for instant testing
  const handleQuickDemoSelect = (presetId: string, age: AgeGroup, conditions: string[], occ: string) => {
    setUserIdInput(presetId);
    setSelectedAgeGroup(age);
    setSelectedConditions(conditions);
    setSelectedOccupation(occ);
    setFullName(presetId.replace(/[-_.]/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()));

    if (existingUsers[presetId]) {
      onLoginSuccess(existingUsers[presetId]);
      onClose();
    } else {
      const p: UserProfile = {
        id: presetId,
        username: presetId,
        fullName: presetId.replace(/[-_.]/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()),
        avatarSeed: presetId,
        ageGroup: age,
        conditions,
        occupation: occ,
        createdAt: new Date().toISOString(),
        updatedAt: new Date().toISOString(),
      };
      onLoginSuccess(p);
      onClose();
    }
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md animate-fade-in">
      <div
        id="auth-modal-card"
        className="relative w-full max-w-lg bg-[#0F0F17] border border-slate-800/80 rounded-3xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh]"
      >
        {/* Header styling with GitHub / MPC aesthetic */}
        <div className="px-6 py-4 bg-[#0A0A10]/90 border-b border-slate-800/60 flex items-center justify-between">
          <div className="flex items-center gap-2.5">
            <div className="w-9 h-9 rounded-xl bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center text-white shadow-[0_0_12px_rgba(6,182,212,0.3)]">
              <Github className="w-4 h-4" />
            </div>
            <div>
              <h3 className="text-sm font-bold text-slate-100 flex items-center gap-2">
                MPC Identity Gateway
                <span className="text-[10px] uppercase tracking-wider font-mono px-2 py-0.5 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-400">
                  LumeAir ID
                </span>
              </h3>
              <p className="text-xs text-slate-400">
                {step === 'enter_id'
                  ? 'Sign in or onboard a new biometric advisory profile'
                  : 'New Account Detected — Configure Vulnerability Profile'}
              </p>
            </div>
          </div>
          <button
            onClick={onClose}
            className="text-slate-400 hover:text-slate-200 p-2 rounded-full hover:bg-slate-800/60 text-sm font-mono cursor-pointer"
          >
            ✕
          </button>
        </div>

        {/* Modal Body */}
        <div className="p-6 overflow-y-auto space-y-5">
          {step === 'enter_id' ? (
            <form onSubmit={handleIdSubmit} className="space-y-4">
              <div>
                <label className="block text-xs font-semibold text-slate-300 mb-1.5 uppercase tracking-wider">
                  User ID / GitHub Handle
                </label>
                <div className="relative">
                  <div className="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                    <Key className="w-4 h-4 text-cyan-400" />
                  </div>
                  <input
                    type="text"
                    required
                    value={userIdInput}
                    onChange={(e) => setUserIdInput(e.target.value)}
                    placeholder="e.g. arjun_delhi, alex_dev, or student_01"
                    className="w-full pl-10 pr-4 py-2.5 bg-slate-950 border border-slate-700 rounded-xl text-slate-100 placeholder:text-slate-500 text-sm focus:outline-hidden focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 font-mono"
                  />
                </div>
                <p className="text-[11px] text-slate-400 mt-1">
                  Existing IDs immediately restore past alert history & profile. New IDs initiate clinical profile onboarding.
                </p>
              </div>

              {errorMsg && (
                <div className="p-2.5 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400 text-xs">
                  {errorMsg}
                </div>
              )}

              <button
                type="submit"
                className="w-full py-2.5 px-4 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-white font-semibold text-sm flex items-center justify-center gap-2 shadow-lg shadow-cyan-950/50 transition-all cursor-pointer"
              >
                <span>Continue with ID</span>
                <ArrowRight className="w-4 h-4" />
              </button>

              {/* Quick Persona Switcher for fast evaluation */}
              <div className="pt-3 border-t border-slate-800/80">
                <div className="text-[11px] font-semibold text-slate-400 uppercase tracking-wider mb-2 flex items-center justify-between">
                  <span>Quick-Load Demo Personas</span>
                  <span className="text-cyan-400 text-[10px]">1-Click Login</span>
                </div>
                <div className="grid grid-cols-1 sm:grid-cols-3 gap-2">
                  <button
                    type="button"
                    onClick={() =>
                      handleQuickDemoSelect('rohan_asthma', 'Adult(20-35)', ['asthma'], 'Outdoor Field Worker / Construction')
                    }
                    className="p-2.5 rounded-xl bg-slate-950/80 hover:bg-slate-800 border border-slate-800 hover:border-cyan-500/50 text-left transition-all group"
                  >
                    <div className="text-xs font-bold text-slate-200 group-hover:text-cyan-300">Rohan (Asthmatic)</div>
                    <div className="text-[10px] text-amber-400">Adult (20-35) • Outdoor</div>
                  </button>

                  <button
                    type="button"
                    onClick={() =>
                      handleQuickDemoSelect('aarav_child', 'child(0-12)', ['asthma', 'dust_allergy'], 'Student / Academic')
                    }
                    className="p-2.5 rounded-xl bg-slate-950/80 hover:bg-slate-800 border border-slate-800 hover:border-cyan-500/50 text-left transition-all group"
                  >
                    <div className="text-xs font-bold text-slate-200 group-hover:text-cyan-300">Aarav (Child)</div>
                    <div className="text-[10px] text-cyan-400">Child (0-12) • Student</div>
                  </button>

                  <button
                    type="button"
                    onClick={() =>
                      handleQuickDemoSelect('mrs_sharma', 'senior(50+)', ['cardiovascular'], 'Senior Citizen / Retired')
                    }
                    className="p-2.5 rounded-xl bg-slate-950/80 hover:bg-slate-800 border border-slate-800 hover:border-cyan-500/50 text-left transition-all group"
                  >
                    <div className="text-xs font-bold text-slate-200 group-hover:text-cyan-300">Mrs. Sharma</div>
                    <div className="text-[10px] text-purple-400">Senior (50+) • Cardio</div>
                  </button>
                </div>
              </div>
            </form>
          ) : (
            <form onSubmit={handleCreateProfileSubmit} className="space-y-4">
              {/* Full Name */}
              <div>
                <label className="block text-xs font-semibold text-slate-300 mb-1">Full Name</label>
                <input
                  type="text"
                  required
                  value={fullName}
                  onChange={(e) => setFullName(e.target.value)}
                  className="w-full px-3.5 py-2 bg-slate-950 border border-slate-700 rounded-xl text-slate-100 text-sm focus:outline-hidden focus:border-cyan-500"
                />
              </div>

              {/* Age Groups: child(0-12), teen(12-19), Adult(20-35), middle age(35-50) and senior(50+) */}
              <div>
                <label className="block text-xs font-semibold text-slate-300 mb-1.5 flex items-center gap-1.5">
                  <User className="w-3.5 h-3.5 text-cyan-400" />
                  Age Group (Required by Advisory Engine)
                </label>
                <div className="grid grid-cols-2 sm:grid-cols-3 gap-2">
                  {AGE_GROUPS.map((group) => {
                    const isSelected = selectedAgeGroup === group;
                    return (
                      <button
                        key={group}
                        type="button"
                        onClick={() => setSelectedAgeGroup(group)}
                        className={`px-3 py-2 rounded-xl text-xs font-medium border text-left transition-all flex items-center justify-between ${
                          isSelected
                            ? 'bg-cyan-950/80 border-cyan-500 text-cyan-200 shadow-sm'
                            : 'bg-slate-950/60 border-slate-800 text-slate-400 hover:border-slate-700'
                        }`}
                      >
                        <span>{group}</span>
                        {isSelected && <Check className="w-3.5 h-3.5 text-cyan-400" />}
                      </button>
                    );
                  })}
                </div>
              </div>

              {/* Health Conditions (Asthma, etc.) */}
              <div>
                <label className="block text-xs font-semibold text-slate-300 mb-1.5 flex items-center gap-1.5">
                  <HeartPulse className="w-3.5 h-3.5 text-rose-400" />
                  Health Conditions (Select all that apply)
                </label>
                <div className="grid grid-cols-1 sm:grid-cols-2 gap-1.5">
                  {PRESET_HEALTH_CONDITIONS.map((cond) => {
                    const isChecked = selectedConditions.includes(cond.id);
                    return (
                      <button
                        key={cond.id}
                        type="button"
                        onClick={() => toggleCondition(cond.id)}
                        className={`px-3 py-2 rounded-xl text-xs font-medium border text-left transition-all flex items-center justify-between ${
                          isChecked
                            ? cond.critical
                              ? 'bg-rose-950/60 border-rose-500/70 text-rose-200'
                              : 'bg-cyan-950/60 border-cyan-500/70 text-cyan-200'
