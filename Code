export const INDIA_MAP_VIEWBOX = {
  width: 620,
  height: 680,
  padX: 25,
  padY: 25,
  minLon: 68.0,
  maxLon: 97.5,
  minLat: 6.5,
  maxLat: 37.3,
};

/**
 * Projects (latitude, longitude) to SVG canvas coordinates (x, y)
 */
export function projectIndiaCoords(lat: number, lon: number): { x: number; y: number } {
  const { width, height, padX, padY, minLon, maxLon, minLat, maxLat } = INDIA_MAP_VIEWBOX;
  const usableW = width - padX * 2;
  const usableH = height - padY * 2;

  const clampedLon = Math.max(minLon, Math.min(maxLon, lon));
  const clampedLat = Math.max(minLat, Math.min(maxLat, lat));

  const x = padX + ((clampedLon - minLon) / (maxLon - minLon)) * usableW;
  const y = height - padY - ((clampedLat - minLat) / (maxLat - minLat)) * usableH;

  return { x: Math.round(x * 10) / 10, y: Math.round(y * 10) / 10 };
}

/**
 * Inverse-projects SVG canvas coordinates (x, y) back to (latitude, longitude)
 */
export function unprojectIndiaCoords(svgX: number, svgY: number): { lat: number; lon: number } {
  const { width, height, padX, padY, minLon, maxLon, minLat, maxLat } = INDIA_MAP_VIEWBOX;
  const usableW = width - padX * 2;
  const usableH = height - padY * 2;

  const lon = minLon + ((svgX - padX) / usableW) * (maxLon - minLon);
  const lat = minLat + ((height - padY - svgY) / usableH) * (maxLat - minLat);

  return {
    lat: Math.round(lat * 1000) / 1000,
    lon: Math.round(lon * 1000) / 1000,
  };
}

