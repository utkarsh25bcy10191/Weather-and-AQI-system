// WMO Weather Interpretation Codes
export function getWeatherDescription(code: number): { text: string; icon: string; bgTone: string } {
  switch (code) {
    case 0:
      return { text: 'Clear Sky', icon: 'Sun', bgTone: 'from-amber-500/20 to-orange-500/10' };
    case 1:
      return { text: 'Mainly Clear', icon: 'SunMedium', bgTone: 'from-amber-500/20 to-sky-500/10' };
    case 2:
      return { text: 'Partly Cloudy', icon: 'CloudSun', bgTone: 'from-sky-500/20 to-slate-500/10' };
    case 3:
      return { text: 'Overcast', icon: 'Cloud', bgTone: 'from-slate-600/20 to-slate-800/10' };
    case 45:
    case 48:
      return { text: 'Foggy / Hazy', icon: 'CloudFog', bgTone: 'from-zinc-500/20 to-slate-700/10' };
    case 51:
    case 53:
    case 55:
      return { text: 'Light Drizzle', icon: 'CloudDrizzle', bgTone: 'from-cyan-500/20 to-blue-600/10' };
    case 61:
    case 63:
    case 65:
      return { text: 'Rain', icon: 'CloudRain', bgTone: 'from-blue-600/20 to-indigo-700/10' };
    case 71:
    case 73:
    case 75:
      return { text: 'Snowfall', icon: 'CloudSnow', bgTone: 'from-indigo-300/20 to-slate-400/10' };
    case 80:
    case 81:
    case 82:
      return { text: 'Rain Showers', icon: 'CloudRain', bgTone: 'from-blue-500/20 to-cyan-700/10' };
    case 95:
    case 96:
    case 99:
      return { text: 'Thunderstorm', icon: 'CloudLightning', bgTone: 'from-purple-600/20 to-red-600/10' };
    default:
      return { text: 'Mild Conditions', icon: 'Cloud', bgTone: 'from-slate-700/20 to-slate-900/10' };
  }
}

// Indian CPCB National Air Quality Index (NAQI) Calculation
// Based on official Central Pollution Control Board (CPCB) continuous sub-index breakpoints
export function calculateIndiaNAQI(
  pm25: number,
  pm10: number,
  no2?: number,
  so2?: number,
  co?: number,
  o3?: number
): { aqi: number; category: AQICurrent['category']; colorHex: string } {
  const subIndexPM25 = calculateContinuousSubIndex(pm25, [
    { cLo: 0, cHi: 30, iLo: 0, iHi: 50 },
    { cLo: 30, cHi: 60, iLo: 50, iHi: 100 },
    { cLo: 60, cHi: 90, iLo: 100, iHi: 200 },
    { cLo: 90, cHi: 120, iLo: 200, iHi: 300 },
    { cLo: 120, cHi: 250, iLo: 300, iHi: 400 },
    { cLo: 250, cHi: 380, iLo: 400, iHi: 500 },
  ]);

  const subIndexPM10 = calculateContinuousSubIndex(pm10, [
    { cLo: 0, cHi: 50, iLo: 0, iHi: 50 },
    { cLo: 50, cHi: 100, iLo: 50, iHi: 100 },
    { cLo: 100, cHi: 250, iLo: 100, iHi: 200 },
    { cLo: 250, cHi: 350, iLo: 200, iHi: 300 },
    { cLo: 350, cHi: 430, iLo: 300, iHi: 400 },
    { cLo: 430, cHi: 500, iLo: 400, iHi: 500 },
  ]);

  let subIndexNO2 = 0;
  if (typeof no2 === 'number' && no2 > 0) {
    subIndexNO2 = calculateContinuousSubIndex(no2, [
      { cLo: 0, cHi: 40, iLo: 0, iHi: 50 },
      { cLo: 40, cHi: 80, iLo: 50, iHi: 100 },
      { cLo: 80, cHi: 180, iLo: 100, iHi: 200 },
      { cLo: 180, cHi: 280, iLo: 200, iHi: 300 },
      { cLo: 280, cHi: 400, iLo: 300, iHi: 400 },
      { cLo: 400, cHi: 500, iLo: 400, iHi: 500 },
    ]);
  }

  let subIndexSO2 = 0;
  if (typeof so2 === 'number' && so2 > 0) {
    subIndexSO2 = calculateContinuousSubIndex(so2, [
      { cLo: 0, cHi: 40, iLo: 0, iHi: 50 },
      { cLo: 40, cHi: 80, iLo: 50, iHi: 100 },
      { cLo: 80, cHi: 380, iLo: 100, iHi: 200 },
      { cLo: 380, cHi: 800, iLo: 200, iHi: 300 },
      { cLo: 800, cHi: 1600, iLo: 300, iHi: 400 },
      { cLo: 1600, cHi: 2000, iLo: 400, iHi: 500 },
    ]);
  }

  let subIndexO3 = 0;
  if (typeof o3 === 'number' && o3 > 0) {
    subIndexO3 = calculateContinuousSubIndex(o3, [
      { cLo: 0, cHi: 50, iLo: 0, iHi: 50 },
      { cLo: 50, cHi: 100, iLo: 50, iHi: 100 },
      { cLo: 100, cHi: 168, iLo: 100, iHi: 200 },
      { cLo: 168, cHi: 208, iLo: 200, iHi: 300 },
      { cLo: 208, cHi: 748, iLo: 300, iHi: 400 },
      { cLo: 748, cHi: 1000, iLo: 400, iHi: 500 },
    ]);
  }

  let subIndexCO = 0;
  if (typeof co === 'number' && co > 0) {
    const coMg = co > 100 ? co / 1000 : co;
    subIndexCO = calculateContinuousSubIndex(coMg, [
      { cLo: 0, cHi: 1.0, iLo: 0, iHi: 50 },
      { cLo: 1.0, cHi: 2.0, iLo: 50, iHi: 100 },
      { cLo: 2.0, cHi: 10.0, iLo: 100, iHi: 200 },
      { cLo: 10.0, cHi: 17.0, iLo: 200, iHi: 300 },
      { cLo: 17.0, cHi: 34.0, iLo: 300, iHi: 400 },
      { cLo: 34.0, cHi: 50.0, iLo: 400, iHi: 500 },
    ]);
  }

  const aqi = Math.round(
    Math.max(subIndexPM25, subIndexPM10, subIndexNO2, subIndexSO2, subIndexO3, subIndexCO)
  );

  if (aqi <= 50) {
    return { aqi, category: 'Good', colorHex: '#10B981' }; // Emerald
  } else if (aqi <= 100) {
    return { aqi, category: 'Satisfactory', colorHex: '#84CC16' }; // Lime
  } else if (aqi <= 200) {
    return { aqi, category: 'Moderate', colorHex: '#F59E0B' }; // Amber
  } else if (aqi <= 300) {
    return { aqi, category: 'Poor', colorHex: '#F97316' }; // Orange
  } else if (aqi <= 400) {
    return { aqi, category: 'Very Poor', colorHex: '#EF4444' }; // Red
  } else {
    return { aqi, category: 'Severe', colorHex: '#7F1D1D' }; // Dark Maroon
  }
}

function calculateContinuousSubIndex(
  conc: number,
  breakpoints: Array<{ cLo: number; cHi: number; iLo: number; iHi: number }>
): number {
  if (conc <= 0 || isNaN(conc)) return 0;
  for (const bp of breakpoints) {
    if (conc <= bp.cHi) {
      const range = bp.cHi - bp.cLo;
      if (range === 0) return bp.iLo;
      return ((bp.iHi - bp.iLo) / range) * (conc - bp.cLo) + bp.iLo;
    }
  }
  const last = breakpoints[breakpoints.length - 1];
  const lastRange = last.cHi - last.cLo;
  const val = ((last.iHi - last.iLo) / lastRange) * (conc - last.cLo) + last.iLo;
  return Math.min(500, Math.max(0, val));
}

// Convert API raw outputs into standardized typed structures
export function parseRawData(weatherRaw: any, aqiRaw: any): {
  weather: WeatherCurrent;
  aqi: AQICurrent;
  trend: DailyTrendPoint[];
} {
  const currentW = weatherRaw?.current || {};
  const currentA = aqiRaw?.current || {};

  const pm25 = currentA.pm2_5 ?? 35;
  const pm10 = currentA.pm10 ?? 60;
  const no2 = currentA.nitrogen_dioxide;
  const so2 = currentA.sulphur_dioxide;
  const co = currentA.carbon_monoxide;
  const o3 = currentA.ozone;

  const { aqi: indiaNaqi, category, colorHex } = calculateIndiaNAQI(
    pm25,
    pm10,
    no2,
    so2,
    co,
    o3
  );

  const weather: WeatherCurrent = {
    temperature: Math.round((currentW.temperature_2m ?? 26) * 10) / 10,
    apparentTemperature: Math.round((currentW.apparent_temperature ?? 27) * 10) / 10,
    humidity: Math.round(currentW.relative_humidity_2m ?? 55),
    weatherCode: currentW.weather_code ?? 0,
    windSpeed: Math.round(currentW.wind_speed_10m ?? 8),
    windDirection: Math.round(currentW.wind_direction_10m ?? 180),
    uvIndex: Math.round((currentW.uv_index ?? 4) * 10) / 10,
    pressure: Math.round(currentW.surface_pressure ?? 1012),
    precipitation: currentW.precipitation ?? 0,
    conditionText: getWeatherDescription(currentW.weather_code ?? 0).text,
  };

  const aqi: AQICurrent = {
    usAqi: Math.round(currentA.us_aqi ?? indiaNaqi),
    indiaNaqi,
    category,
    colorHex,
    pm25: Math.round(pm25 * 10) / 10,
    pm10: Math.round(pm10 * 10) / 10,
    no2: Math.round((currentA.nitrogen_dioxide ?? 15) * 10) / 10,
    so2: Math.round((currentA.sulphur_dioxide ?? 8) * 10) / 10,
    co: Math.round((currentA.carbon_monoxide ?? 250) * 10) / 10,
    o3: Math.round((currentA.ozone ?? 45) * 10) / 10,
    dust: currentA.dust ? Math.round(currentA.dust * 10) / 10 : undefined,
  };

  // Build 7-day past trend
  const dailyW = weatherRaw?.daily || {};
  const hourlyA = aqiRaw?.hourly || {};
  const trend: DailyTrendPoint[] = [];

  const timeArr: string[] = dailyW.time || [];
  // Calculate daily average AQI from hourly data
  const hourlyTimes: string[] = hourlyA.time || [];
  const hourlyPM25: number[] = hourlyA.pm2_5 || [];
  const hourlyPM10: number[] = hourlyA.pm10 || [];

  timeArr.forEach((dateStr, idx) => {
    // Find matching hours for this day
    const dayIndices: number[] = [];
    hourlyTimes.forEach((hTime, hIdx) => {
      if (hTime.startsWith(dateStr)) {
        dayIndices.push(hIdx);
      }
    });

    let avgPM25 = pm25;
    let avgPM10 = pm10;
    if (dayIndices.length > 0) {
      const sum25 = dayIndices.reduce((acc, i) => acc + (hourlyPM25[i] || 0), 0);
      const sum10 = dayIndices.reduce((acc, i) => acc + (hourlyPM10[i] || 0), 0);
      avgPM25 = sum25 / dayIndices.length;
      avgPM10 = sum10 / dayIndices.length;
    }

    const isToday = idx === timeArr.length - 1;
    const { aqi: computedDayAqi } = calculateIndiaNAQI(avgPM25, avgPM10);
    const dayAqi = isToday ? indiaNaqi : computedDayAqi;
    const dateObj = new Date(dateStr);
    const dayLabel = dateObj.toLocaleDateString('en-US', { weekday: 'short', day: 'numeric' });

    trend.push({
      date: dateStr,
      dayLabel,
      aqi: dayAqi,
      tempMax: Math.round(dailyW.temperature_2m_max?.[idx] ?? (weather.temperature + 3)),
      tempMin: Math.round(dailyW.temperature_2m_min?.[idx] ?? (weather.temperature - 4)),
      humidity: Math.round(weather.humidity + (idx % 3) * 2 - 2),
      windSpeed: Math.round(dailyW.wind_speed_10m_max?.[idx] ?? weather.windSpeed),
      weatherCode: dailyW.weather_code?.[idx] ?? weather.weatherCode,
      conditionText: getWeatherDescription(dailyW.weather_code?.[idx] ?? weather.weatherCode).text,
    });
  });

  return { weather, aqi, trend };
}
