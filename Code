  const [isOpen, setIsOpen] = useState(false);
  const [isSearching, setIsSearching] = useState(false);
  const [showStatePicker, setShowStatePicker] = useState(false);
  const [stateFilter, setStateFilter] = useState('');
  const containerRef = useRef<HTMLDivElement>(null);
  const statePickerRef = useRef<HTMLDivElement>(null);

  // Notify parent component if search/picker is active for stacking context elevation
  useEffect(() => {
    onActiveChange?.(isOpen || showStatePicker);
  }, [isOpen, showStatePicker, onActiveChange]);

  // Global Escape key listener to dismiss dropdowns
  useEffect(() => {
    const handleGlobalKeyDown = (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        setIsOpen(false);
        setShowStatePicker(false);
      }
    };
    window.addEventListener('keydown', handleGlobalKeyDown);
    return () => window.removeEventListener('keydown', handleGlobalKeyDown);
  }, []);

  // Parse coordinate input e.g. "28.61, 77.20"
  const checkCoordinateInput = (text: string): { lat: number; lon: number } | null => {
    const parts = text.split(/[, ]+/).filter(Boolean);
    if (parts.length === 2) {
      const lat = parseFloat(parts[0]);
      const lon = parseFloat(parts[1]);
      if (!isNaN(lat) && !isNaN(lon) && lat >= -90 && lat <= 90 && lon >= -180 && lon <= 180) {
        return { lat, lon };
      }
    }
    return null;
  };

  // Debounced search
  useEffect(() => {
    if (!query.trim() || query.trim().length < 2) {
      setResults([]);
      return;
    }

    // Check if user entered coordinates
    const coords = checkCoordinateInput(query.trim());
    if (coords) {
      const isIndia = coords.lat >= 6.5 && coords.lat <= 37.3 && coords.lon >= 68.0 && coords.lon <= 97.5;
      setResults([
        {
          name: `Coordinates (${coords.lat.toFixed(2)}°N, ${coords.lon.toFixed(2)}°E)`,
          state: isIndia ? 'India Territorial Boundary' : 'Global Point',
          country: isIndia ? 'India' : 'International',
          lat: coords.lat,
          lon: coords.lon,
          isIndia,
        },
      ]);
      setIsOpen(true);
      return;
    }

    const timer = setTimeout(async () => {
      setIsSearching(true);
      try {
        const res = await fetch(`/api/geocode?q=${encodeURIComponent(query.trim())}`);
        if (res.ok) {
          const data = await res.json();
          setResults(
            (data.results || []).map((item: any) => ({
              name: item.name,
              state: item.admin1 || item.admin2 || '',
              country: item.country || '',
              lat: item.latitude,
              lon: item.longitude,
              isIndia: item.isIndia,
            }))
          );
          setIsOpen(true);
        }
      } catch (err) {
        console.error('Geocoding error:', err);
      } finally {
        setIsSearching(false);
      }
    }, 250);

    return () => clearTimeout(timer);
  }, [query]);

