import React, { useState } from 'react';
import { UserProfile, AgeGroup } from '../types';
import { User, HeartPulse, Briefcase, Check, Save, LogOut, ShieldAlert } from 'lucide-react';

interface ProfileModalProps {
  isOpen: boolean;
  onClose: () => void;
  profile: UserProfile;
  onUpdateProfile: (updated: UserProfile) => void;
  onLogout: () => void;
}

const AGE_GROUPS: AgeGroup[] = [
  'child(0-12)',
  'teen(12-19)',
  'Adult(20-35)',
  'middle age(35-50)',
  'senior(50+)',
];

const PRESET_HEALTH_CONDITIONS = [
  { id: 'asthma', label: 'Asthma (Hyper-reactive airways)', critical: true },
  { id: 'bronchitis', label: 'Bronchitis / COPD', critical: true },
  { id: 'cardiovascular', label: 'Cardiovascular / Heart Disease', critical: true },
  { id: 'dust_allergy', label: 'Dust & Pollen Allergy (Rhinitis)', critical: false },
  { id: 'sinusitis', label: 'Chronic Sinusitis', critical: false },
  { id: 'pregnancy', label: 'Pregnancy', critical: true },
  { id: 'healthy', label: 'None / Generally Healthy', critical: false },
];

const PRESET_OCCUPATIONS = [
  'Outdoor Field Worker / Construction',
  'Delivery Partner / Transit Driver',
  'Athlete / Outdoor Sports',
  'Indoor / Desk / IT Professional',
  'Student / Academic',
  'Senior Citizen / Retired',
  'Healthcare / Emergency Worker',
  'Other',
];

export const ProfileModal: React.FC<ProfileModalProps> = ({
  isOpen,
  onClose,
  profile,
  onUpdateProfile,
  onLogout,
}) => {
  const [fullName, setFullName] = useState(profile.fullName);
  const [ageGroup, setAgeGroup] = useState<AgeGroup>(profile.ageGroup);
  const [conditions, setConditions] = useState<string[]>(profile.conditions || []);
  const [occupation, setOccupation] = useState(profile.occupation);
  const [notes, setNotes] = useState(profile.notes || '');
  const [isSaved, setIsSaved] = useState(false);

  if (!isOpen) return null;

  const toggleCondition = (condId: string) => {
    if (condId === 'healthy') {
      setConditions(['healthy']);
      return;
    }
    const filtered = conditions.filter((c) => c !== 'healthy');
    if (filtered.includes(condId)) {
      setConditions(filtered.filter((c) => c !== condId));
    } else {
      setConditions([...filtered, condId]);
    }
  };

  const handleSave = (e: React.FormEvent) => {
    e.preventDefault();
    const updated: UserProfile = {
      ...profile,
      fullName: fullName.trim() || profile.fullName,
      ageGroup,
      conditions,
      occupation,
      notes: notes.trim(),
      updatedAt: new Date().toISOString(),
    };
    onUpdateProfile(updated);
    setIsSaved(true);
    setTimeout(() => {
      setIsSaved(false);
      onClose();
    }, 600);
  };

  const hasAsthma = conditions.some((c) => c.toLowerCase().includes('asthma'));

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md animate-fade-in">
      <div
        id="profile-modal-card"
        className="relative w-full max-w-lg bg-[#0F0F17] border border-slate-800/80 rounded-3xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh]"
      >
        {/* Header */}
        <div className="px-6 py-4 bg-[#0A0A10]/90 border-b border-slate-800/60 flex items-center justify-between">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-full bg-gradient-to-tr from-cyan-600 to-indigo-600 border border-cyan-400/40 flex items-center justify-center font-bold text-white shadow-[0_0_12px_rgba(6,182,212,0.3)]">
              {profile.fullName.charAt(0).toUpperCase()}
            </div>
            <div>
              <h3 className="text-base font-bold text-slate-100 flex items-center gap-2">
                {profile.fullName}
                <span className="text-xs font-mono font-normal text-cyan-400">@{profile.username}</span>
              </h3>
              <p className="text-xs text-slate-400">Manage your medical vulnerability profile & advisory preferences</p>
            </div>
          </div>
          <button
            onClick={onClose}
            className="text-slate-400 hover:text-slate-200 p-2 rounded-full hover:bg-slate-800/60 text-sm font-mono cursor-pointer"
          >
            ✕
          </button>
        </div>

        {/* Clinical Alert Callout if user has Asthma */}
        {hasAsthma && (
          <div className="mx-6 mt-4 p-3 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs flex items-center gap-2.5">
            <ShieldAlert className="w-4 h-4 text-amber-400 shrink-0" />
            <span>
              <strong>Asthma Advisory Activated:</strong> LumeAir automatically calibrates sensitivity thresholds for PM2.5 bronchospasm and triggers inhaler alerts.
            </span>
          </div>
        )}

        {/* Form Body */}
        <form onSubmit={handleSave} className="p-6 overflow-y-auto space-y-4">
          {/* Full Name */}
          <div>
            <label className="block text-xs font-semibold text-slate-300 mb-1">Display Name</label>
            <input
              type="text"
              required
              value={fullName}
              onChange={(e) => setFullName(e.target.value)}
              className="w-full px-3.5 py-2 bg-slate-950 border border-slate-700 rounded-xl text-slate-100 text-sm focus:outline-hidden focus:border-cyan-500"
            />
          </div>

          {/* Age Group */}
          <div>
            <label className="block text-xs font-semibold text-slate-300 mb-1.5 flex items-center gap-1.5">
              <User className="w-3.5 h-3.5 text-cyan-400" />
              Age Group (Clinical Cohort)
            </label>
            <div className="grid grid-cols-2 sm:grid-cols-3 gap-2">
              {AGE_GROUPS.map((group) => {
                const isSelected = ageGroup === group;
                return (
                  <button
                    key={group}
                    type="button"
                    onClick={() => setAgeGroup(group)}
                    className={`px-3 py-2 rounded-xl text-xs font-medium border text-left transition-all flex items-center justify-between ${
                      isSelected
                        ? 'bg-cyan-950/80 border-cyan-500 text-cyan-200 shadow-sm'
                        : 'bg-slate-950/60 border-slate-800 text-slate-400 hover:border-slate-700'
                    }`}
                  >
                    <span>{group}</span>
                    {isSelected && <Check className="w-3.5 h-3.5 text-cyan-400" />}
                  </button>
                );
              })}
            </div>
          </div>

          {/* Health Conditions */}
          <div>
            <label className="block text-xs font-semibold text-slate-300 mb-1.5 flex items-center gap-1.5">
              <HeartPulse className="w-3.5 h-3.5 text-rose-400" />
              Health Conditions
            </label>
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-1.5">
              {PRESET_HEALTH_CONDITIONS.map((cond) => {
                const isChecked = conditions.includes(cond.id);
                return (
                  <button
                    key={cond.id}
                    type="button"
                    onClick={() => toggleCondition(cond.id)}
                    className={`px-3 py-2 rounded-xl text-xs font-medium border text-left transition-all flex items-center justify-between ${
                      isChecked
                        ? cond.critical
                          ? 'bg-rose-950/60 border-rose-500/70 text-rose-200'
                          : 'bg-cyan-950/60 border-cyan-500/70 text-cyan-200'
                        : 'bg-slate-950/60 border-slate-800 text-slate-400 hover:border-slate-700'
                    }`}
                  >
                    <span className="truncate">{cond.label}</span>
                    {isChecked && <Check className="w-3.5 h-3.5 shrink-0" />}
                  </button>
                );
              })}
            </div>
          </div>

          {/* Occupation */}
          <div>
            <label className="block text-xs font-semibold text-slate-300 mb-1.5 flex items-center gap-1.5">
              <Briefcase className="w-3.5 h-3.5 text-amber-400" />
              Occupation / Exposure Level
            </label>
            <select
              value={occupation}
              onChange={(e) => setOccupation(e.target.value)}
              className="w-full px-3.5 py-2 bg-slate-950 border border-slate-700 rounded-xl text-slate-100 text-sm focus:outline-hidden focus:border-cyan-500"
            >
              {PRESET_OCCUPATIONS.map((occ) => (
                <option key={occ} value={occ}>
                  {occ}
                </option>
              ))}
            </select>
          </div>

          {/* Notes */}
          <div>
            <label className="block text-xs font-semibold text-slate-300 mb-1">
              Sensitivity Notes & Prescriptions
            </label>
            <input
              type="text"
              value={notes}
              onChange={(e) => setNotes(e.target.value)}
              placeholder="e.g. Asthma triggered by pollen and cold air"
              className="w-full px-3.5 py-2 bg-slate-950 border border-slate-700 rounded-xl text-slate-100 text-sm focus:outline-hidden focus:border-cyan-500"
            />
          </div>

          {/* Actions */}
          <div className="flex items-center justify-between pt-3 border-t border-slate-800">
            <button
              type="button"
              onClick={() => {
                onLogout();
                onClose();
              }}
              className="flex items-center gap-2 px-3 py-2 rounded-xl text-xs font-medium text-rose-400 hover:bg-rose-500/10 border border-rose-500/20 transition-colors"
            >
              <LogOut className="w-3.5 h-3.5" />
              <span>Log Out</span>
            </button>

            <div className="flex items-center gap-2">
              <button
                type="button"
                onClick={onClose}
                className="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-medium"
              >
                Cancel
              </button>
              <button
                type="submit"
                className="flex items-center gap-2 px-4 py-2 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-white text-xs font-semibold shadow-md transition-all cursor-pointer"
              >
                <Save className="w-3.5 h-3.5" />
                <span>{isSaved ? 'Changes Saved!' : 'Save Profile'}</span>
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  );
};
