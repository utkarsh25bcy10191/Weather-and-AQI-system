  }

  // If all models hit quota or timeout, seamlessly serve the clinical rule-based advisory
  const fallback = generateRuleBasedAdvisory(userProfile, weatherData, aqiData, locationName);
  advisoryCache.set(cacheKey, { advisory: fallback, timestamp: Date.now() });
  return res.json({
    source: "expert_clinical_engine",
    advisory: fallback,
  });
});

// Rule-based advisory fallback helper
function generateRuleBasedAdvisory(userProfile: any, weatherData: any, aqiData: any, locationName: string) {
  const aqi = aqiData?.indiaNaqi || aqiData?.usAqi || 100;
  const pm25 = aqiData?.pm25 || 35;
  const temp = weatherData?.temperature || 28;
  const conditions: string[] = userProfile?.conditions || [];
  const hasAsthma = conditions.some((c: string) => c.toLowerCase().includes("asthma"));
  const hasCardio = conditions.some((c: string) => c.toLowerCase().includes("cardio") || c.toLowerCase().includes("heart"));
  const isVulnerableAge = userProfile?.ageGroup === "child(0-12)" || userProfile?.ageGroup === "senior(50+)";
  const isOutdoorWorker = (userProfile?.occupation || "").toLowerCase().includes("outdoor") || (userProfile?.occupation || "").toLowerCase().includes("construction") || (userProfile?.occupation || "").toLowerCase().includes("driver");

  let riskLevel = "Moderate";
  if (aqi > 300 || pm25 > 120) {
    riskLevel = "Severe";
  } else if (aqi > 200 || (aqi > 150 && (hasAsthma || isVulnerableAge))) {
    riskLevel = "High";
  } else if (aqi <= 50 && pm25 <= 15) {
    riskLevel = "Low";
  }

  const dos: string[] = [];
  const donts: string[] = [];

  // DOs
  if (aqi > 150 || pm25 > 60) {
    dos.push("Wear a well-fitted certified N95 or FFP2 respirator mask when stepping outdoors.");
    dos.push("Operate HEPA air purifiers inside living and working spaces; keep windows sealed during peak smog.");
  } else if (aqi > 100) {
    dos.push("Wear a protective mask if exposed to high-traffic roadside areas for extended periods.");
    dos.push("Keep windows shut during early morning hours when surface temperature inversions trap pollutants.");
  } else {
    dos.push("Take advantage of clean air hours to properly ventilate living quarters and exercise outdoors.");
  }

  if (hasAsthma) {
    dos.push("Keep fast-acting bronchodilator rescue inhaler (Salbutamol) immediately accessible at all times.");
    dos.push("Rinse mouth, eyes, and nasal passages with saline mist upon returning from outside.");
  }

  if (temp > 35) {
    dos.push("Drink at least 3.5 to 4 liters of electrolytes and clean water to counter thermal exhaustion.");
  } else {
    dos.push("Stay well hydrated to keep respiratory mucosal membranes moist and capable of filtering dust.");
  }

  if (isOutdoorWorker) {
    dos.push("Take mandatory 15-minute rest breaks in filtered, climate-controlled or sheltered indoor environments every 2 hours.");
  }

  // DONTs
  if (aqi > 150) {
    donts.push("DO NOT engage in high-intensity cardiovascular cardio (running, cycling, HIIT) outdoors.");
    donts.push("DO NOT burn candles, incense sticks (agarbatti), or mosquito coils indoors as they multiply PM2.5.");
  } else {
    donts.push("DO NOT exercise near congested highways, industrial corridors, or heavy diesel truck routes.");
  }

  if (hasAsthma || isVulnerableAge) {
    donts.push("DO NOT venture outdoors during early morning hours (6 AM - 9 AM) and late evenings when particulate concentration peaks.");
  }

  if (temp > 35) {
    donts.push("DO NOT stay under direct midday sun (12 PM - 3:30 PM) without UV sunblock, cap, and sunglasses.");
  }

  donts.push("DO NOT rely on simple cloth or surgical masks; they fail to trap microscopic PM2.5 and PM0.1 aerosols.");

  return {
    riskLevel,
    summary: `Air quality in ${locationName || "your area"} is currently rated ${riskLevel}. With ${hasAsthma ? "asthma and " : ""}${userProfile?.occupation || "current activity"}, particulate inhalation poses heightened respiratory resistance.`,
    dos,
    donts,
    maskGuidance: aqi > 100 ? "N95 / FFP2 respirator mask required outdoors." : "Mask optional; recommended in traffic choke-points.",
    indoorGuidance: aqi > 100 ? "Seal windows; run HEPA filtration on medium-high; avoid indoor frying/incense." : "Natural cross-ventilation encouraged.",
    outdoorGuidance: aqi > 200 ? "Minimize all non-essential outdoor exposure." : aqi > 100 ? "Limit outdoor activities to under 45 minutes." : "Safe for outdoor activities.",
    medicationAlert: hasAsthma ? "Keep rescue inhaler close by. Check peak expiratory flow if chest tightness occurs." : "Monitor for throat scratchiness, watery eyes, or coughing.",
  };
}

