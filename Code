            </div>
          </div>

          {/* Quick Preset City Bar */}
          <div className="hidden lg:flex items-center gap-1.5 overflow-x-auto py-1">
            {PRESET_INDIAN_CITIES.slice(0, 5).map((city) => {
              const isSelected = city.name === currentLocation.name;
              return (
                <button
