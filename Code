2. Exactly 4 to 6 concise, bulleted DO's (e.g. specific mask grade N95/FFP2, air purifier HEPA settings, indoor hydration, peak hour scheduling).
3. Exactly 4 to 6 concise, bulleted DONT's (e.g. avoid morning jog when inversion traps particulates, do not burn incense/candles, avoid heavy outdoor exertion).
4. Specific notes tailored to their age group and condition (especially if they have Asthma, COPD, heart disease, or are a child/senior).
5. Return clean JSON format with keys:
{
  "riskLevel": "Low" | "Moderate" | "High" | "Severe",
  "summary": "Concise 2-sentence summary tailored to this user",
  "dos": ["do item 1", "do item 2", ...],
  "donts": ["don't item 1", "don't item 2", ...],
  "maskGuidance": "Explicit guidance on masks (e.g., N95 recommended)",
  "indoorGuidance": "Guidance on air purifiers, windows, and ventilation",
  "outdoorGuidance": "Timing and restrictions for outdoor work or exercise",
  "medicationAlert": "Specific note for their health condition (e.g., carry rescue inhaler if asthmatic)"
}`;

  // Check advisory cache first to conserve quota and provide instantaneous responses
  const cacheKey = `${locationName || "default"}_${aqiData?.indiaNaqi || aqiData?.usAqi || 0}_${userProfile?.id || "anon"}_${userProfile?.ageGroup || ""}_${(userProfile?.conditions || []).join(",")}`;
  const cached = advisoryCache.get(cacheKey);
  if (cached && Date.now() - cached.timestamp < 15 * 60 * 1000) {
    return res.json({
      source: "cached_advisory",
      advisory: cached.advisory,
    });
  }

  const ai = getGenAI();
  if (!ai) {
    const fallback = generateRuleBasedAdvisory(userProfile, weatherData, aqiData, locationName);
    return res.json({
      source: "expert_rule_engine",
      advisory: fallback,
    });
  }

  // Attempt generation with available models in priority order
  for (const model of ADVISORY_MODELS) {
    try {
      const timeoutPromise = new Promise((_, reject) =>
        setTimeout(() => reject(new Error("Gemini generation timeout")), 3000)
      );

      const geminiPromise = ai.models.generateContent({
        model,
        contents: prompt,
        config: {
          responseMimeType: "application/json",
        },
      });

      const response: any = await Promise.race([geminiPromise, timeoutPromise]);
      const text = response.text || "{}";
      let parsed = JSON.parse(text);

      if (parsed && typeof parsed === "object" && parsed.riskLevel) {
        advisoryCache.set(cacheKey, { advisory: parsed, timestamp: Date.now() });
        return res.json({
          source: model,
          advisory: parsed,
        });
      }
    } catch {
