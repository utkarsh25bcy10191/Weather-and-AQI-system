export const IndiaMap: React.FC<IndiaMapProps> = ({
  currentLocation,
  currentWeather,
  currentAQI,
  onSelectLocation,
  isLoading = false,
}) => {
  const [zoomLevel, setZoomLevel] = useState(1);
  const [showPresets, setShowPresets] = useState(true);
  const [hoverCoords, setHoverCoords] = useState<{ lat: number; lon: number; x: number; y: number } | null>(null);
  const [isReverseGeocoding, setIsReverseGeocoding] = useState(false);

  // Check if current location is inside India coordinates
  const isInsideIndia =
    currentLocation.lat >= 6.5 &&
    currentLocation.lat <= 37.3 &&
    currentLocation.lon >= 68.0 &&
    currentLocation.lon <= 97.5;

  const activeDot = projectIndiaCoords(currentLocation.lat, currentLocation.lon);

  // Handle clicking anywhere on the map to choose any location
  const handleMapClick = async (e: React.MouseEvent<SVGSVGElement>) => {
    const svg = e.currentTarget;
    const rect = svg.getBoundingClientRect();
    const clickX = e.clientX - rect.left;
    const clickY = e.clientY - rect.top;

    const scaleX = INDIA_MAP_VIEWBOX.width / rect.width;
    const scaleY = INDIA_MAP_VIEWBOX.height / rect.height;

    const svgX = clickX * scaleX;
    const svgY = clickY * scaleY;

    const { lat, lon } = unprojectIndiaCoords(svgX, svgY);

    if (lat >= 6.5 && lat <= 37.3 && lon >= 68.0 && lon <= 97.5) {
      // Immediate optimistic update
      const initialLoc: LocationInfo = {
        name: `Location (${lat.toFixed(2)}°N, ${lon.toFixed(2)}°E)`,
        lat,
        lon,
        isIndia: true,
      };
      onSelectLocation(initialLoc);

      // Perform reverse-geocode to get real Indian place name
      setIsReverseGeocoding(true);
      try {
        const res = await fetch(`/api/reverse-geocode?lat=${lat}&lon=${lon}`);
        if (res.ok) {
          const data = await res.json();
          onSelectLocation({
            name: data.name || `Point (${lat.toFixed(2)}°N, ${lon.toFixed(2)}°E)`,
            state: data.state || '',
            country: data.country || 'India',
            lat,
            lon,
            isIndia: true,
          });
        }
      } catch (err) {
        console.warn('Reverse geocode error:', err);
      } finally {
        setIsReverseGeocoding(false);
      }
    }
  };

  const handleMouseMove = (e: React.MouseEvent<SVGSVGElement>) => {
    const svg = e.currentTarget;
    const rect = svg.getBoundingClientRect();
    const clickX = e.clientX - rect.left;
    const clickY = e.clientY - rect.top;

    const scaleX = INDIA_MAP_VIEWBOX.width / rect.width;
    const scaleY = INDIA_MAP_VIEWBOX.height / rect.height;

    const svgX = clickX * scaleX;
    const svgY = clickY * scaleY;

    const { lat, lon } = unprojectIndiaCoords(svgX, svgY);
    if (lat >= 6.5 && lat <= 37.3 && lon >= 68.0 && lon <= 97.5) {
      setHoverCoords({ lat, lon, x: svgX, y: svgY });
    } else {
      setHoverCoords(null);
    }
  };

  const handleMouseLeave = () => {
    setHoverCoords(null);
  };

