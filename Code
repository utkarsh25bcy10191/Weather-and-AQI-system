// API: Geocode search (Open-Meteo Geocoding prioritized for India)
app.get("/api/geocode", async (req, res) => {
  const query = req.query.q as string;
  if (!query || query.trim().length === 0) {
    return res.json({ results: [] });
  }

  try {
    const cleanQ = query.trim();
    // Try general search
    const url = `https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(
      cleanQ
    )}&count=15&language=en&format=json`;
    const response = await fetch(url);
    if (!response.ok) {
      throw new Error(`Geocoding failed with status ${response.status}`);
    }
    const data = await response.json();
    let results = (data.results || []).map((item: any) => ({
      name: item.name,
      latitude: item.latitude,
      longitude: item.longitude,
      country: item.country || "",
      country_code: item.country_code || "",
      admin1: item.admin1 || "",
      admin2: item.admin2 || "",
      isIndia:
        item.country_code === "IN" ||
        item.country?.toLowerCase() === "india" ||
        (item.latitude >= 6.5 && item.latitude <= 37.3 && item.longitude >= 68.0 && item.longitude <= 97.5),
    }));

    // Prioritize Indian results
    results.sort((a: any, b: any) => {
      if (a.isIndia && !b.isIndia) return -1;
      if (!a.isIndia && b.isIndia) return 1;
      return 0;
    });

    return res.json({ results });
  } catch (err: any) {
    console.error("Geocode error:", err.message);
    return res.status(500).json({ error: "Failed to search location", message: err.message });
  }
});

// API: Reverse Geocode (convert lat/lon to Indian place name)
app.get("/api/reverse-geocode", async (req, res) => {
  const latStr = req.query.lat as string;
  const lonStr = req.query.lon as string;
  const lat = parseFloat(latStr);
  const lon = parseFloat(lonStr);

  if (isNaN(lat) || isNaN(lon)) {
    return res.status(400).json({ error: "Invalid coordinates" });
  }

  const isInsideIndia = lat >= 6.5 && lat <= 37.3 && lon >= 68.0 && lon <= 97.5;

  try {
    // OpenStreetMap Nominatim reverse geocode
    const url = `https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lon}&zoom=10&addressdetails=1`;
    const response = await fetch(url, {
      headers: {
        "User-Agent": "LumeAir-Environmental-System/1.0",
      },
    });

    if (response.ok) {
      const data = await response.json();
      const addr = data.address || {};
      const cityName =
        addr.city ||
        addr.town ||
        addr.village ||
        addr.municipality ||
        addr.county ||
        addr.district ||
        addr.state_district ||
        data.name ||
        `Region (${lat.toFixed(2)}°N, ${lon.toFixed(2)}°E)`;
      const stateName = addr.state || "";
      const countryName = addr.country || (isInsideIndia ? "India" : "");

      return res.json({
        name: cityName,
        state: stateName,
        country: countryName,
        lat,
        lon,
        isIndia: isInsideIndia || addr.country_code === "in" || countryName.toLowerCase() === "india",
        displayName: [cityName, stateName].filter(Boolean).join(", "),
      });
    }
  } catch (err: any) {
    console.warn("Reverse geocoding fetch error:", err.message);
  }

  return res.json({
    name: `Location (${lat.toFixed(2)}°N, ${lon.toFixed(2)}°E)`,
    state: isInsideIndia ? "India" : "",
    country: isInsideIndia ? "India" : "International",
    lat,
    lon,
    isIndia: isInsideIndia,
    displayName: `${lat.toFixed(2)}°N, ${lon.toFixed(2)}°E`,
  });
});

// API: Live Weather & AQI + past 7-day trend proxy
app.get("/api/weather-aqi", async (req, res) => {
  const latStr = req.query.lat as string;
  const lonStr = req.query.lon as string;

  const lat = parseFloat(latStr);
  const lon = parseFloat(lonStr);

  if (isNaN(lat) || isNaN(lon)) {
    return res.status(400).json({ error: "Invalid lat/lon coordinates" });
  }

  try {
    // 1. Fetch live current weather + 7-day past & forecast data
    const weatherUrl = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=temperature_2m,relative_humidity_2m,apparent_temperature,precipitation,weather_code,surface_pressure,wind_speed_10m,wind_direction_10m,uv_index&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_sum,wind_speed_10m_max,uv_index_max&past_days=7&forecast_days=1&timezone=auto`;
    
    // 2. Fetch live Air Quality & past 7-day AQI trend
    const aqiUrl = `https://air-quality-api.open-meteo.com/v1/air-quality?latitude=${lat}&longitude=${lon}&current=european_aqi,us_aqi,pm10,pm2_5,carbon_monoxide,nitrogen_dioxide,sulphur_dioxide,ozone,dust&hourly=pm10,pm2_5,us_aqi,european_aqi&past_days=7&forecast_days=1&timezone=auto`;

